{% extends "admin/base_site.html" %}
{% load i18n static %}

{% block extrastyle %}
{{ block.super }}
<style>
/* Override the base admin body for login page */
html, body {
  height: 100% !important;
  margin: 0 !important;
  overflow: hidden !important;
}

body.login {
  background: #0f172a !important;
  overflow: hidden !important;
}

/* Hide the standard header and breadcrumbs on login */
body.login #header,
body.login #dds-admin-strip,
body.login div.breadcrumbs { display: none !important; }

/* Remove default Django login container */
body.login #container { background: transparent !important; }
body.login #content-main { padding: 0 !important; }
body.login #main { padding: 0 !important; }
body.login #content { padding: 0 !important; }

/* ─── Full-page login layout ─────────────────────────────── */
.dds-login-wrapper {
  display: flex;
  min-height: 100vh;
  font-family: 'Inter', system-ui, sans-serif;
}

/* Left panel — branding */
.dds-login-left {
  flex: 1 1 55%;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f2744 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 60px 48px;
  position: relative;
  overflow: hidden;
}

/* Decorative circles */
.dds-login-left::before {
  content: '';
  position: absolute;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%);
  top: -100px; right: -100px;
  border-radius: 50%;
  pointer-events: none;
}

.dds-login-left::after {
  content: '';
  position: absolute;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(16,185,129,0.1) 0%, transparent 70%);
  bottom: -80px; left: -80px;
  border-radius: 50%;
  pointer-events: none;
}

.dds-login-brand { position: relative; z-index: 2; text-align: center; max-width: 420px; }

.dds-login-brand img {
  height: 90px;
  width: auto;
  object-fit: contain;
  margin-bottom: 28px;
  filter: drop-shadow(0 4px 24px rgba(59,130,246,0.3));
}

.dds-login-brand h1 {
  font-size: 2.2rem;
  font-weight: 800;
  color: #f8fafc;
  letter-spacing: -0.02em;
  line-height: 1.15;
  margin: 0 0 12px;
}

.dds-login-brand h1 span { color: #10b981; }

.dds-login-brand p {
  font-size: 1rem;
  color: #94a3b8;
  line-height: 1.6;
  margin: 0 0 40px;
}

/* Feature pills on left panel */
.dds-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}

.dds-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 99px;
  padding: 6px 14px;
  font-size: 0.8rem;
  color: #cbd5e1;
  font-weight: 500;
}

.dds-pill-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
}

/* Bottom strip on left */
.dds-login-footer {
  position: absolute;
  bottom: 24px;
  left: 0; right: 0;
  text-align: center;
  font-size: 0.72rem;
  color: #334155;
  z-index: 2;
}

/* Right panel — form */
.dds-login-right {
  flex: 0 0 420px;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 56px 40px;
  box-shadow: -4px 0 40px rgba(0,0,0,0.4);
  overflow-y: auto;
}

.dds-login-right .form-header {
  margin-bottom: 32px;
}

.dds-login-right .form-header h2 {
  font-size: 1.5rem;
  font-weight: 700;
  color: #0f172a;
  margin: 0 0 6px;
}

.dds-login-right .form-header p {
  font-size: 0.875rem;
  color: #64748b;
  margin: 0;
}

/* Error banner */
.errornote {
  background: #fee2e2 !important;
  color: #991b1b !important;
  border: 1px solid #fca5a5 !important;
  border-radius: 10px !important;
  padding: 12px 16px !important;
  font-size: 0.875rem !important;
  margin-bottom: 20px !important;
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
}

/* Form fields */
.dds-login-right .form-group {
  margin-bottom: 20px;
}

.dds-login-right label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #374151;
  margin-bottom: 6px;
}

.dds-login-right input[type="text"],
.dds-login-right input[type="password"] {
  width: 100% !important;
  padding: 10px 14px !important;
  border: 1.5px solid #e2e8f0 !important;
  border-radius: 10px !important;
  font-size: 0.9375rem !important;
  color: #0f172a !important;
  background: #ffffff !important;
  transition: border-color 0.2s, box-shadow 0.2s !important;
  outline: none !important;
  font-family: 'Inter', sans-serif !important;
}

.dds-login-right input[type="text"]:focus,
.dds-login-right input[type="password"]:focus {
  border-color: #3b82f6 !important;
  box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
}

/* Submit button */
.dds-login-right .submit-row,
.dds-login-right [type="submit"] {
  width: 100%;
  padding: 12px;
  background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%) !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 10px !important;
  font-size: 1rem !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  transition: all 0.25s !important;
  letter-spacing: 0.01em !important;
  font-family: 'Inter', sans-serif !important;
  box-shadow: 0 4px 14px rgba(37,99,235,0.35) !important;
  margin-top: 8px !important;
}

.dds-login-right [type="submit"]:hover {
  transform: translateY(-1px) !important;
  box-shadow: 0 6px 20px rgba(37,99,235,0.45) !important;
}

.dds-login-right [type="submit"]:active {
  transform: translateY(0) !important;
}

/* Divider */
.dds-divider {
  height: 1px;
  background: #e2e8f0;
  margin: 28px 0;
}

/* Admin info */
.dds-login-info {
  font-size: 0.75rem;
  color: #94a3b8;
  text-align: center;
  line-height: 1.5;
}

/* Responsive — stack on small screens */
@media (max-width: 768px) {
  html, body { overflow: auto !important; }
  .dds-login-wrapper { flex-direction: column; }
  .dds-login-left { flex: none; padding: 40px 24px 32px; }
  .dds-login-left::before, .dds-login-left::after { display: none; }
  .dds-login-right { flex: none; width: 100%; padding: 32px 24px; box-shadow: none; }
}
</style>
{% endblock %}

{% block content_title %}{% endblock %}

{% block content %}
<div class="dds-login-wrapper">

  <!-- ── Left: branding ──────────────────────────────────────────────── -->
  <div class="dds-login-left">
    <div class="dds-login-brand">
      <img src="{% static 'images/dds_logo.png' %}" alt="DDS Logo" />

      <h1>
        DDS <span>Admin</span><br>
        Control Panel
      </h1>
      <p>
        Secure access to the Development Decision Support management system.
        Manage content, teams, publications, and more.
      </p>

      <div class="dds-pills">
        <div class="dds-pill">
          <span class="dds-pill-dot" style="background:#3b82f6;"></span>
          Research Management
        </div>
        <div class="dds-pill">
          <span class="dds-pill-dot" style="background:#10b981;"></span>
          Projects &amp; Cases
        </div>
        <div class="dds-pill">
          <span class="dds-pill-dot" style="background:#f59e0b;"></span>
          Publications
        </div>
        <div class="dds-pill">
          <span class="dds-pill-dot" style="background:#8b5cf6;"></span>
          Team Directory
        </div>
        <div class="dds-pill">
          <span class="dds-pill-dot" style="background:#ec4899;"></span>
          Contact Enquiries
        </div>
        <div class="dds-pill">
          <span class="dds-pill-dot" style="background:#06b6d4;"></span>
          News &amp; Updates
        </div>
      </div>
    </div>

    <div class="dds-login-footer">
      © {% now "Y" %} Development Decision Support (DDS) — Freetown, Sierra Leone
    </div>
  </div>

  <!-- ── Right: login form ───────────────────────────────────────────── -->
  <div class="dds-login-right">
    <div class="form-header">
      <h2>Welcome back</h2>
      <p>Sign in to your administrator account</p>
    </div>

    {% if form.errors and not form.non_field_errors %}
    <div class="errornote">
      <svg xmlns="http://www.w3.org/2000/svg" style="width:18px;height:18px;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      {% if form.errors.items|length == 1 %}
        {% trans "Please correct the error below." %}
      {% else %}
        {% trans "Please correct the errors below." %}
      {% endif %}
    </div>
    {% endif %}

    {% if form.non_field_errors %}
    <div class="errornote">
      <svg xmlns="http://www.w3.org/2000/svg" style="width:18px;height:18px;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      {% for error in form.non_field_errors %}{{ error }}{% endfor %}
    </div>
    {% endif %}

    <form method="post" id="login-form" action="{{ app_path }}">
      {% csrf_token %}

      <input type="hidden" name="next" value="{{ next }}" />

      <!-- Username -->
      <div class="form-group">
        <label for="{{ form.username.id_for_label }}">
          {% trans "Username" %}
        </label>
        {% if form.username.errors %}
          <ul class="errorlist" style="margin:0 0 6px;padding:0;list-style:none;">
            {% for error in form.username.errors %}
            <li style="font-size:.75rem;color:#dc2626;">{{ error }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {{ form.username }}
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="{{ form.password.id_for_label }}">
          {% trans "Password" %}
        </label>
        {% if form.password.errors %}
          <ul class="errorlist" style="margin:0 0 6px;padding:0;list-style:none;">
            {% for error in form.password.errors %}
            <li style="font-size:.75rem;color:#dc2626;">{{ error }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {{ form.password }}
      </div>

      <!-- Submit -->
      <div class="submit-row" style="background:transparent!important;border:none!important;padding:0!important;border-radius:0!important;display:block!important;">
        <input type="submit" value="{% trans 'Sign In' %}" />
      </div>

      {% url 'admin:password_reset' as password_reset_url %}
      {% if password_reset_url %}
      <div style="text-align:center;margin-top:16px;">
        <a href="{{ password_reset_url }}"
           style="font-size:0.8125rem;color:#2563eb;text-decoration:none;font-weight:500;">
          {% trans "Forgot your password?" %}
        </a>
      </div>
      {% endif %}
    </form>

    <div class="dds-divider"></div>

    <div class="dds-login-info">
      <strong style="color:#374151;">Authorised Access Only</strong><br>
      This system is restricted to DDS staff. Unauthorised access is prohibited.<br>
      Contact <a href="mailto:info@ddsconsultancy.org" style="color:#2563eb;">info@ddsconsultancy.org</a> for access.
    </div>
  </div>

</div>
{% endblock %}
